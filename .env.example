# ─────────────────────────────────────────────────────────────────────────────
# ManosYa — Variables de entorno
# Copiar a .env.local y completar los valores.
# NUNCA commitear .env.local ni .env con valores reales.
# ─────────────────────────────────────────────────────────────────────────────

# ── App ───────────────────────────────────────────────────────────────────────
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_APP_NAME=ManosYa
NODE_ENV=development

# ── Base de datos ─────────────────────────────────────────────────────────────
# Neon Postgres (producción): usar connection pooler para NEXTJS, directa para migraciones
# Docker local: usar la URL del docker-compose
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/manosya?schema=public
# Solo necesario en producción con Neon (pooler vs direct)
DATABASE_DIRECT_URL=postgresql://postgres:postgres@localhost:5432/manosya?schema=public

# ── Auth.js (NextAuth v5) ─────────────────────────────────────────────────────
# Generar con: openssl rand -base64 32
AUTH_SECRET=REEMPLAZAR_CON_SECRET_SEGURO_32_CHARS_BASE64

# Google OAuth — Crear en: https://console.cloud.google.com/
AUTH_GOOGLE_ID=tu-google-client-id.apps.googleusercontent.com
AUTH_GOOGLE_SECRET=tu-google-client-secret

# ── Cloudflare R2 (Storage de imágenes) ──────────────────────────────────────
# Crear bucket en: https://dash.cloudflare.com/
R2_ACCOUNT_ID=tu-cloudflare-account-id
R2_ACCESS_KEY_ID=tu-r2-access-key-id
R2_SECRET_ACCESS_KEY=tu-r2-secret-access-key
R2_BUCKET_NAME=manosya-dev
R2_PUBLIC_URL=https://pub-XXXX.r2.dev

# ── Pusher (Realtime / Chat) ──────────────────────────────────────────────────
# Crear app en: https://dashboard.pusher.com/
PUSHER_APP_ID=tu-pusher-app-id
PUSHER_KEY=tu-pusher-key
PUSHER_SECRET=tu-pusher-secret
PUSHER_CLUSTER=sa1
# sa1 = South America (São Paulo) — menor latencia para AR
NEXT_PUBLIC_PUSHER_KEY=tu-pusher-key
NEXT_PUBLIC_PUSHER_CLUSTER=sa1

# ── Resend (Email transaccional) ──────────────────────────────────────────────
# Crear en: https://resend.com/
RESEND_API_KEY=re_XXXXXXXXXXXXXXXXXXXX
RESEND_FROM_EMAIL=noreply@manosya.com.ar

# ── Mercado Pago ──────────────────────────────────────────────────────────────
# Credenciales en: https://www.mercadopago.com.ar/developers/
# Usar credenciales de SANDBOX para desarrollo
MERCADOPAGO_ACCESS_TOKEN=TEST-XXXXXXXXXXXXXXXXXXXX
MERCADOPAGO_PUBLIC_KEY=TEST-XXXXXXXXXXXXXXXXXXXX
# URL a la que MP redirige después del pago
MERCADOPAGO_WEBHOOK_SECRET=tu-webhook-secret
NEXT_PUBLIC_MERCADOPAGO_PUBLIC_KEY=TEST-XXXXXXXXXXXXXXXXXXXX

# ── Upstash Redis (Rate limiting) ─────────────────────────────────────────────
# Crear en: https://console.upstash.com/
UPSTASH_REDIS_REST_URL=https://XXXXX.upstash.io
UPSTASH_REDIS_REST_TOKEN=tu-upstash-token

# ── Admin ─────────────────────────────────────────────────────────────────────
# Email del primer admin (se otorga role ADMIN en seed o manualmente en DB)
ADMIN_EMAIL=admin@manosya.com.ar
