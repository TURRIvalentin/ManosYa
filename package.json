    "clsx": "^2.1.1",
    "embla-carousel-react": "^8.3.0",
    "lucide-react": "^0.460.0",
    "mercadopago": "^2.0.15",
    "next": "14.2.18",
    "next-auth": "^5.0.0-beta.25",
    "pusher": "^5.2.0",
    "pusher-js": "^8.4.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "resend": "^4.0.1",
    "sharp": "^0.33.5",
