// ManosYa — Schema completo v2
// Convención: PascalCase modelos, camelCase campos, UPPER_CASE enums

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DATABASE_DIRECT_URL")
}

// ─────────────────────────────────────────────────────────────────────────────
// AUTH (Auth.js / NextAuth v5)
// ─────────────────────────────────────────────────────────────────────────────

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String    @unique
  emailVerified DateTime?
  image         String?
  phone         String?
  role          UserRole  @default(USER)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  // Soft delete: el usuario "borrado" se anonimiza después de 30 días (Ley 25.326)
  deletedAt     DateTime?

  accounts        Account[]
  sessions        Session[]
  clientProfile   ClientProfile?
  providerProfile ProviderProfile?
  sentMessages    Message[]
  notifications   Notification[]

  @@index([email])
  @@index([deletedAt])
}

enum UserRole {
  USER
  ADMIN
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@index([userId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

// ─────────────────────────────────────────────────────────────────────────────
// PERFILES
// ─────────────────────────────────────────────────────────────────────────────

model ClientProfile {
  id        String   @id @default(cuid())
  userId    String   @unique
  address   String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user     User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  requests Request[]
  reviews  Review[]

  @@index([userId])
}

model ProviderProfile {
  id     String @id @default(cuid())
  userId String @unique

  bio       String? @db.Text
  avatarUrl String?

  // Verificación manual por admin
  isVerified   Boolean   @default(false)
  verifiedAt   DateTime?
  verifiedById String?
  dniUrl       String?
  cuil         String?
  // cuil tiene su propio validador de dígito verificador en src/lib/validations/cuil.ts
  licenseNumber String?
  licenseType   String?
  licenseUrl    String?

  // Rating desnormalizado para performance en búsqueda
  // Actualizar con trigger/Server Action tras cada Review
  ratingAvg   Float @default(0)
  ratingCount Int   @default(0)

  plan                Plan      @default(FREE)
  planExpiresAt       DateTime?
  isFeatured          Boolean   @default(false)
  // Límite de contactos para plan FREE (se resetea el 1º de cada mes)
  monthlyContactCount Int       @default(0)
  monthlyContactReset DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user          User                   @relation(fields: [userId], references: [id], onDelete: Cascade)
  services      ProviderService[]
  zones         ProviderZone[]
  availability  ProviderAvailability[]
  quotes        Quote[]
  reviews       Review[]
  subscriptions Subscription[]

  @@index([userId])
  // Índice compuesto para ordenamiento en búsqueda: isFeatured DESC, ratingAvg DESC
  @@index([isFeatured, ratingAvg])
  // Para filtros combinados en búsqueda: verificado + plan + rating
  @@index([isVerified, plan, ratingAvg])
  @@index([ratingCount])
}

enum Plan {
  FREE
  PRO
}

// ─────────────────────────────────────────────────────────────────────────────
// CATEGORÍAS
// ─────────────────────────────────────────────────────────────────────────────

model Category {
  id          String  @id @default(cuid())
  slug        String  @unique
  name        String
  description String?
  iconName    String?
  imageUrl    String?
  sortOrder   Int     @default(0)
  isActive    Boolean @default(true)

  parentId String?
  parent   Category?  @relation("CategoryTree", fields: [parentId], references: [id])
  children Category[] @relation("CategoryTree")

  providerServices ProviderService[]
  requests         Request[]

  @@index([slug])
  @@index([parentId])
  @@index([isActive, sortOrder])
}

// ─────────────────────────────────────────────────────────────────────────────
// ZONAS GEOGRÁFICAS
// ─────────────────────────────────────────────────────────────────────────────

model Zone {
  id       String   @id @default(cuid())
  slug     String   @unique
  name     String
  type     ZoneType
  province String   @default("Buenos Aires")
  lat      Float?
  lng      Float?

  providerZones ProviderZone[]
  requests      Request[]

  @@index([type])
  @@index([slug])
}

enum ZoneType {
  BARRIO_CABA
  PARTIDO_GBA
}

model ProviderZone {
  id                String @id @default(cuid())
  providerProfileId String
  zoneId            String

  providerProfile ProviderProfile @relation(fields: [providerProfileId], references: [id], onDelete: Cascade)
  zone            Zone            @relation(fields: [zoneId], references: [id], onDelete: Cascade)

  @@unique([providerProfileId, zoneId])
  @@index([providerProfileId])
  // Orden invertido crítico: "dame todos los prestadores de la zona X"
  @@index([zoneId, providerProfileId])
}

// ─────────────────────────────────────────────────────────────────────────────
// SERVICIOS DEL PRESTADOR
// ─────────────────────────────────────────────────────────────────────────────

model ProviderService {
  id                String @id @default(cuid())
  providerProfileId String
  categoryId        String

  title       String
  description String?   @db.Text
  // Decimal(12,2): soporta hasta $9,999,999,999.99 ARS sin error de punto flotante
  priceFrom      Decimal?  @db.Decimal(12, 2)
  priceTo        Decimal?  @db.Decimal(12, 2)
  priceUnit      PriceUnit @default(POR_TRABAJO)
  // Permite mostrar "precio actualizado hace X días" en la UI
  priceUpdatedAt DateTime?
  isActive       Boolean   @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  providerProfile ProviderProfile @relation(fields: [providerProfileId], references: [id], onDelete: Cascade)
  category        Category        @relation(fields: [categoryId], references: [id])
  images          ServiceImage[]

  @@index([providerProfileId])
  // Índice compuesto para búsqueda: "prestadores de categoría X"
  @@index([categoryId, providerProfileId, isActive])
  @@index([isActive])
}

enum PriceUnit {
  POR_HORA
  POR_TRABAJO
  POR_M2
  A_CONVENIR
}

model ServiceImage {
  id                String  @id @default(cuid())
  providerServiceId String
  url               String
  altText           String?
  sortOrder         Int     @default(0)

  providerService ProviderService @relation(fields: [providerServiceId], references: [id], onDelete: Cascade)

  @@index([providerServiceId])
}

model ProviderAvailability {
  id                String @id @default(cuid())
  providerProfileId String
  dayOfWeek         Int    // 0 = Domingo … 6 = Sábado
  startTime         String // "09:00"
  endTime           String // "18:00"

  providerProfile ProviderProfile @relation(fields: [providerProfileId], references: [id], onDelete: Cascade)

  @@unique([providerProfileId, dayOfWeek])
  @@index([providerProfileId])
}

// ─────────────────────────────────────────────────────────────────────────────
// SOLICITUDES (REQUESTS)
// ─────────────────────────────────────────────────────────────────────────────

model Request {
  id              String        @id @default(cuid())
  clientProfileId String
  categoryId      String
  zoneId          String

  title            String
  description      String        @db.Text
  status           RequestStatus @default(OPEN)
  targetProviderId String?

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  expiresAt DateTime?
  // Soft delete: el cliente puede "eliminar" un pedido de su historial
  deletedAt DateTime?

  clientProfile ClientProfile @relation(fields: [clientProfileId], references: [id])
  category      Category      @relation(fields: [categoryId], references: [id])
  zone          Zone          @relation(fields: [zoneId], references: [id])

  images       RequestImage[]
  quotes       Quote[]
  conversation Conversation?
  review       Review?

  @@index([clientProfileId])
  // Índice compuesto para feed de pedidos abiertos: zona + categoría + fecha
  @@index([status, zoneId, categoryId, createdAt])
  @@index([targetProviderId])
  @@index([deletedAt])
}

enum RequestStatus {
  OPEN
  QUOTED
  HIRED
  IN_PROGRESS
  COMPLETED
  CANCELLED
  EXPIRED
}

model RequestImage {
  id        String  @id @default(cuid())
  requestId String
  url       String
  altText   String?

  request Request @relation(fields: [requestId], references: [id], onDelete: Cascade)

  @@index([requestId])
}

// ─────────────────────────────────────────────────────────────────────────────
// PRESUPUESTOS (QUOTES)
// ─────────────────────────────────────────────────────────────────────────────

model Quote {
  id                String      @id @default(cuid())
  requestId         String
  providerProfileId String

  // Decimal(12,2): consistencia con ProviderService.priceFrom/priceTo
  price         Decimal     @db.Decimal(12, 2)
  currency      String      @default("ARS")
  estimatedDays Int?
  comment       String?     @db.Text
  status        QuoteStatus @default(PENDING)

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  expiresAt DateTime?

  request         Request         @relation(fields: [requestId], references: [id], onDelete: Cascade)
  providerProfile ProviderProfile @relation(fields: [providerProfileId], references: [id])

  @@unique([requestId, providerProfileId])
  @@index([requestId])
  @@index([providerProfileId])
  @@index([status])
}

enum QuoteStatus {
  PENDING
  ACCEPTED
  REJECTED
  WITHDRAWN
  EXPIRED
}

// ─────────────────────────────────────────────────────────────────────────────
// MENSAJERÍA
// ─────────────────────────────────────────────────────────────────────────────

model Conversation {
  id        String   @id @default(cuid())
  requestId String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  request      Request                  @relation(fields: [requestId], references: [id], onDelete: Cascade)
  messages     Message[]
  participants ConversationParticipant[]
}

model ConversationParticipant {
  id             String    @id @default(cuid())
  conversationId String
  userId         String
  lastReadAt     DateTime?

  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@unique([conversationId, userId])
  @@index([conversationId])
  @@index([userId])
}

model Message {
  id             String      @id @default(cuid())
  conversationId String
  senderId       String

  body          String      @db.Text
  type          MessageType @default(TEXT)
  attachmentUrl String?

  createdAt DateTime  @default(now())
  readAt    DateTime?
  // Soft delete: "borrar para mí" (similar a WhatsApp)
  deletedAt DateTime?

  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  sender       User         @relation(fields: [senderId], references: [id])

  // Índice compuesto para cargar historial excluyendo mensajes borrados
  @@index([conversationId, deletedAt, createdAt])
  @@index([senderId])
}

enum MessageType {
  TEXT
  IMAGE
  SYSTEM
}

// ─────────────────────────────────────────────────────────────────────────────
// RESEÑAS
// ─────────────────────────────────────────────────────────────────────────────

model Review {
  id                String @id @default(cuid())
  requestId         String @unique
  clientProfileId   String
  providerProfileId String

  clientRating       Int
  clientComment      String?   @db.Text
  clientReviewedAt   DateTime?

  providerRating     Int?
  providerComment    String?   @db.Text
  providerReviewedAt DateTime?

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  // Soft delete: admin puede ocultar reseñas abusivas sin destruir el historial
  deletedAt DateTime?

  request         Request         @relation(fields: [requestId], references: [id])
  clientProfile   ClientProfile   @relation(fields: [clientProfileId], references: [id])
  providerProfile ProviderProfile @relation(fields: [providerProfileId], references: [id])

  // Índice compuesto para perfil de prestador: reseñas activas ordenadas por fecha
  @@index([providerProfileId, deletedAt, clientReviewedAt])
  @@index([clientProfileId])
  @@index([deletedAt])
}

// ─────────────────────────────────────────────────────────────────────────────
// PAGOS Y SUSCRIPCIONES
// ─────────────────────────────────────────────────────────────────────────────

model Subscription {
  id                String @id @default(cuid())
  providerProfileId String

  plan   Plan
  status SubscriptionStatus

  mpPreferenceId String?
  mpPaymentId    String?
  mpExternalRef  String? @unique

  // Decimal(12,2): sin errores de flotante en importes de suscripción
  amount   Decimal @db.Decimal(12, 2)
  currency String  @default("ARS")

  startsAt    DateTime
  endsAt      DateTime
  cancelledAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  providerProfile ProviderProfile @relation(fields: [providerProfileId], references: [id])

  @@index([providerProfileId])
  @@index([status])
  @@index([mpExternalRef])
}

enum SubscriptionStatus {
  PENDING
  ACTIVE
  CANCELLED
  EXPIRED
  FAILED
}

// ─────────────────────────────────────────────────────────────────────────────
// NOTIFICACIONES
// ─────────────────────────────────────────────────────────────────────────────

model Notification {
  id          String           @id @default(cuid())
  userId      String
  type        NotificationType
  title       String
  body        String
  data        Json?
  readAt      DateTime?
  emailSentAt DateTime?
  createdAt   DateTime         @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, readAt])
  @@index([createdAt])
}

enum NotificationType {
  NEW_QUOTE
  QUOTE_ACCEPTED
  QUOTE_REJECTED
  NEW_MESSAGE
  REQUEST_COMPLETED
  REVIEW_RECEIVED
  VERIFICATION_APPROVED
  SUBSCRIPTION_RENEWED
  SUBSCRIPTION_EXPIRED
  SUBSCRIPTION_FAILED
}

// ─────────────────────────────────────────────────────────────────────────────
// ADMIN
// ─────────────────────────────────────────────────────────────────────────────

model AuditLog {
  id         String   @id @default(cuid())
  adminId    String
  action     String
  targetType String
  targetId   String
  metadata   Json?
  ipAddress  String?
  createdAt  DateTime @default(now())

  @@index([adminId])
  @@index([targetType, targetId])
  @@index([createdAt])
}

model Report {
  id         String       @id @default(cuid())
  reporterId String
  targetType String
  targetId   String
  reason     ReportReason
  comment    String?      @db.Text
  status     ReportStatus @default(PENDING)
  resolvedBy String?
  resolvedAt DateTime?
  createdAt  DateTime     @default(now())

  @@index([status])
  @@index([reporterId])
  @@index([targetType, targetId])
}

enum ReportReason {
  SPAM
  FAKE_PROFILE
  INAPPROPRIATE_CONTENT
  SCAM
  OTHER
}

enum ReportStatus {
  PENDING
  REVIEWED
  RESOLVED
  DISMISSED
}
